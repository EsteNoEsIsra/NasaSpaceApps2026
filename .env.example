# ── App ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Frontend ─────────────────────────────────────────────
VITE_API_URL=http://localhost:3000

# ── Database (PostgreSQL) ────────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_USER=nasa
DB_PASSWORD=nasa_secret
DB_NAME=hackathon
DATABASE_URL=postgresql://nasa:nasa_secret@db:5432/hackathon

# ── Redis ────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret

# ── JWT ──────────────────────────────────────────────────
JWT_SECRET=change_me_in_production_use_a_long_random_string
JWT_EXPIRES_IN=7d

# ── NASA API ─────────────────────────────────────────────
NASA_API_KEY=DEMO_KEY
